<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vs</ToolCommandName>
    <PackageId>VictoriousSecret.Cli</PackageId>
    <Version>0.1.0</Version>
<Description>CLI for Victorious Secret repository scanning.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ktsu.CredentialCache" Version="1.3.62" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

</Project>
